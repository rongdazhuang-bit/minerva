# FastAPI 根地址（无尾部斜杠）。开发留空则走 Vite 代理，浏览器访问 http://localhost:5173 即可。
# 若浏览器需直连后端（不经代理），可设为 http://127.0.0.1:8000
# VITE_API_BASE_URL=

# Vite 开发代理超时（毫秒）。须大于后端 AI_HTTP_READ_TIMEOUT（默认 120s），否则润色等长请求会 ERR_EMPTY_RESPONSE。
# MINERVA_DEV_API_PROXY_TIMEOUT_MS=180000

# npm run build 堆内存上限（MB，默认 4096）。小内存机器 OOM 时可设为 8192 或更高。
# MINERVA_NODE_MAX_OLD_SPACE_SIZE=8192
