# =============================================================================
# Minerva Backend 本地/团队开发配置（.env.dev）
# =============================================================================
# 由 run-backend dev / run-celery dev <worker|beat> 加载（APP_ENV=dev，单文件无叠加）。
# 含密钥时请勿提交到公开仓库（根 .gitignore 已忽略 .env，本文件若入库请脱敏）。
# =============================================================================

APP_ENV=dev
APP_NAME=minerva-api

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=7
LOG_BODY_ENABLED=true
LOG_BODY_MAX_CHARS=20000
LOG_FILE_ENABLED=true
LOG_STDOUT_ENABLED=true
LOG_SQL_ENABLED=false

# PostgreSQL（远程开发库）
DATABASE_URL=postgresql+asyncpg://postgres:KnWhMG4C4aDGTrE6@127.0.0.1:55432/minerva
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:KnWhMG4C4aDGTrE6@127.0.0.1:55432/minerva
AUTO_CREATE_TABLES=true

JWT_SECRET=jAXUrRxewoHpWKSVbmQiTz2J35aYcLBF
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12
AUTH_LOGIN_CAPTCHA_ENABLED=true
AUTH_LOGIN_CAPTCHA_TTL_SECONDS=300
AUTH_LOGIN_CAPTCHA_LENGTH=4

AI_HTTP_CONNECT_TIMEOUT=10
AI_HTTP_READ_TIMEOUT=120
AI_RETRY_MAX_ATTEMPTS=3

# Redis：与下方 Celery 使用同一实例；db0=broker，db1=result
# 注：REDIS_URL 仅作备忘，应用不读取该键，实际以 CELERY_* 为准
REDIS_URL=redis://:9CdFEJgVu2i1esnM@127.0.0.1:56379/0
CELERY_BROKER_URL=redis://:9CdFEJgVu2i1esnM@127.0.0.1:56379/0
CELERY_RESULT_BACKEND=redis://:9CdFEJgVu2i1esnM@127.0.0.1:56379/1
CELERY_DEFAULT_QUEUE=default
CELERY_SCHEDULE_SYNC_CHANNEL=minerva:celery:schedule_sync
CELERY_SCHEDULE_RECONCILE_SECONDS=60
CELERY_BEAT_HOT_RELOAD_VIA_REDIS=true
CELERY_BEAT_MAX_LOOP_SECONDS=8
CELERY_SCHEDULED_TASK_LOCK_TTL_SECONDS=3600
CELERY_REDIS_SOCKET_CONNECT_TIMEOUT=30
CELERY_REDIS_SOCKET_TIMEOUT=30
CELERY_REDIS_HEALTH_CHECK_INTERVAL=30
CELERY_BROKER_CONNECTION_MAX_RETRIES=0

AGENT_MAX_PLAN_STEPS=8
AGENT_SUBAGENT_RECURSION_LIMIT=16
AGENT_MEMORY_RETRIEVE_LIMIT=20
AGENT_MESSAGE_FALLBACK_LIMIT=50
AGENT_MEMORY_BACKEND=sql
AGENT_CHAT_HISTORY_MESSAGE_LIMIT=40
AGENT_ENABLE_THINKING=false
MCP_CLIENT_ENABLED=false
MCP_SERVER_ENABLED=false
MCP_CONNECT_TIMEOUT=30
AGENT_LANGGRAPH_CHECKPOINT_ENABLED=true
AGENT_LANGGRAPH_CHECKPOINT_POOL_MIN_SIZE=1
AGENT_LANGGRAPH_CHECKPOINT_POOL_MAX_SIZE=8
AGENT_LANGGRAPH_CHECKPOINT_POOL_TIMEOUT=60
AGENT_LANGGRAPH_CHECKPOINT_RETENTION_DAYS=7
AGENT_LANGGRAPH_CHECKPOINT_CLEANUP_ENABLED=true
AGENT_LANGGRAPH_CHECKPOINT_CLEANUP_BATCH_SIZE=1000
AGENT_FILES_ROOT=
AGENT_FILE_MAX_BYTES=524288
# Agent 消息附件（默认 5 个，5MB，图片/pdf/文本/docx/xlsx 等）
# AGENT_ATTACHMENT_MAX_COUNT=5
# AGENT_ATTACHMENT_MAX_BYTES=5242880
# AGENT_ATTACHMENT_ALLOWED_MIME=image/jpeg,image/jpg,image/png,image/gif,image/webp,application/pdf,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
# AGENT_ATTACHMENT_DOWNLOAD_EXPIRES_IN=3600
FILE_STORAGE_LOCAL_ROOT=./data/file-storage

DOC_TRANSLATE_MAX_FILE_BYTES=20971520
DOC_TRANSLATE_SEGMENT_CONCURRENCY=5
DOC_TRANSLATE_OCR_POLL_INTERVAL_SECONDS=2
DOC_TRANSLATE_OCR_TIMEOUT_SECONDS=1800
DOC_TRANSLATE_DEFAULT_OCR_TYPE=PADDLE_OCR
DOC_TRANSLATE_SOFFICE_EXECUTABLE=
DOC_TRANSLATE_SOFFICE_TIMEOUT_SECONDS=120
LAYOUT_PAGE_RASTER_PREFIX=ocr/page-raster
LAYOUT_SCHEMA_VERSION=1

# 知识库（Dataset）
DATASET_VECTOR_STORE=pgvector
DATASET_VECTOR_INDEX_NAME_PREFIX=Vector_index
DATASET_KEYWORD_STORE=jieba
DATASET_BATCH_UPLOAD_LIMIT=10
DATASET_MAX_FILES_PER_DATASET=5
DATASET_SINGLE_FILE_SIZE_LIMIT_MB=100
DATASET_PGVECTOR_URL=
DATASET_QDRANT_URL=
DATASET_QDRANT_API_KEY=
DATASET_WEAVIATE_ENDPOINT=
DATASET_WEAVIATE_API_KEY=

# 知识图谱（GraphKB）；LightRAG 须使用 GRAPH_KB_LIGHTRAG_*，禁止复用 MEM0_* 配置
GRAPH_KB_DATA=
GRAPH_KB_LIGHTRAG_DATABASE_URL=
GRAPH_KB_JOB_TIMEOUT_SECONDS=7200
GRAPH_KB_INLINE_TEXT_MAX_CHARS=20000
GRAPH_KB_LIGHTRAG_WORKER_URL=http://127.0.0.1:8101
GRAPH_KB_GRAPHRAG_WORKER_URL=http://127.0.0.1:8102
# GraphKB 引擎客户端：http（默认，调独立 Worker）或 fake（进程内假实现，供测试）
GRAPH_KB_ENGINE_CLIENT=http

# 高德 Web 服务（Agent skills: ip_location / district / weather）
AMAP_WEB_SERVICE_KEY=

# =============================================================================
# 以下变量不由 app/config.py 读取，供脚本、测试或操作系统使用
# =============================================================================

# scripts/run-celery.*：Worker 池（Windows 默认 threads；Linux 默认 prefork）
# MINERVA_CELERY_POOL=threads
# MINERVA_CELERY_CONCURRENCY=4
# 兼容旧开关：MINERVA_CELERY_USE_PREFORK=1 等价于 prefork
