# =============================================================================
# Minerva GraphKB GraphRAG Worker（独立配置，不读取 backend/.env.*）
# =============================================================================
# 启动脚本默认 WORKER_ENV=dev → 加载本目录 .env.dev
# =============================================================================

WORKER_ENV=dev

# Bearer 认证（须与 backend/.env.<APP_ENV> 中 GRAPH_KB_GRAPHRAG_WORKER_API_KEY 一致）
GRAPH_KB_GRAPHRAG_WORKER_API_KEY=

# 1 = 跳过 GraphRAG SDK（文件假实现）
GRAPH_KB_WORKER_FAKE=1

# GraphRAG silo 父目录；空则 backend/data/graph_kb
GRAPH_KB_DATA=

# Chat / Embedding（GRAPH_KB_WORKER_FAKE=0 时必填）
GRAPH_KB_LLM_BASE_URL=
GRAPH_KB_LLM_API_KEY=
GRAPH_KB_LLM_MODEL=
GRAPH_KB_EMBEDDING_BASE_URL=
GRAPH_KB_EMBEDDING_API_KEY=
GRAPH_KB_EMBEDDING_MODEL=
