# =============================================================================
# Minerva GraphKB LightRAG Worker（独立配置，不读取 backend/.env.*）
# =============================================================================
# 启动脚本默认 WORKER_ENV=dev → 加载本目录 .env.dev
# 复制为 .env.local 并设置 WORKER_ENV=local 可覆盖个人配置（勿提交密钥）
# =============================================================================

WORKER_ENV=dev

# Bearer 认证（须与 backend/.env.<APP_ENV> 中 GRAPH_KB_LIGHTRAG_WORKER_API_KEY 一致）
GRAPH_KB_LIGHTRAG_WORKER_API_KEY=

# 1 = 跳过 LightRAG SDK（内存假实现，本地/CI）
GRAPH_KB_WORKER_FAKE=1

# 真实引擎：LightRAG 专用 PostgreSQL（禁止复用 MEM0_*）
GRAPH_KB_LIGHTRAG_DATABASE_URL=

# 向量维度（默认 1536）
GRAPH_KB_EMBEDDING_DIM=1536

# Chat / Embedding（GRAPH_KB_WORKER_FAKE=0 时必填）
GRAPH_KB_LLM_BASE_URL=
GRAPH_KB_LLM_API_KEY=
GRAPH_KB_LLM_MODEL=
GRAPH_KB_EMBEDDING_BASE_URL=
GRAPH_KB_EMBEDDING_API_KEY=
GRAPH_KB_EMBEDDING_MODEL=
