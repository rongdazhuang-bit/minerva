# =============================================================================
# Minerva Backend 环境变量模板（.env.example）
# =============================================================================
# 应用通过 app/config.py（Pydantic Settings）加载配置，优先级：
#   1. 进程环境变量（shell / 启动脚本 / IDE / CI）
#   2. backend/.env.<APP_ENV>  单个文件（无叠加）
#
# 本地默认：复制为 .env.local 后修改（run-backend 无参即加载）
# 团队 dev：复制为 .env.dev，使用 run-backend dev / run-celery dev worker
# 生产请使用强随机 JWT_SECRET，并将 AUTO_CREATE_TABLES 设为 false，仅用 Alembic 管理表结构。
# =============================================================================

# -----------------------------------------------------------------------------
# 运行环境
# -----------------------------------------------------------------------------
# 环境 profile 名；对应 backend/.env.<APP_ENV>，并影响 CORS（dev/development/local/test 放宽）
APP_ENV=local
# FastAPI 应用标题（OpenAPI 文档等）
APP_NAME=minerva-api

# -----------------------------------------------------------------------------
# 日志
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=7
LOG_BODY_ENABLED=true
LOG_BODY_MAX_CHARS=20000
LOG_FILE_ENABLED=true
LOG_STDOUT_ENABLED=true
# 为 true 时输出每条 SQL 及执行耗时（毫秒）；默认 false
LOG_SQL_ENABLED=false

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# 异步 SQLAlchemy（asyncpg），供 FastAPI / 业务 API 使用
DATABASE_URL=postgresql+asyncpg://minerva:minerva@127.0.0.1:5432/minerva
# 同步 URL（psycopg2），供 Alembic、Celery 同步任务、LangGraph checkpoint 清理等
SYNC_DATABASE_URL=postgresql+psycopg2://minerva:minerva@127.0.0.1:5432/minerva
# 启动时按 ORM 元数据补建缺表；生产建议 false
AUTO_CREATE_TABLES=true

# -----------------------------------------------------------------------------
# JWT 与密码
# -----------------------------------------------------------------------------
# 签名密钥，至少 32 字节随机串；勿使用示例值上线
JWT_SECRET=change_me_dev_only_32_bytes_minimum_please
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12
# 登录/注册图形验证码（Redis 存储，见 CELERY_BROKER_URL）
AUTH_LOGIN_CAPTCHA_ENABLED=true
AUTH_LOGIN_CAPTCHA_TTL_SECONDS=300
AUTH_LOGIN_CAPTCHA_LENGTH=4

# -----------------------------------------------------------------------------
# AI 上游 HTTP（app.llm）
# -----------------------------------------------------------------------------
AI_HTTP_CONNECT_TIMEOUT=10
AI_HTTP_READ_TIMEOUT=120
AI_RETRY_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Celery / Redis
# -----------------------------------------------------------------------------
# Broker：任务队列（默认 Redis db 0）
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Result backend：任务状态与结果（默认 Redis db 1）
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_DEFAULT_QUEUE=default
# Beat 热更新：Postgres 调度变更后通过 Redis pub/sub 通知 Beat
CELERY_SCHEDULE_SYNC_CHANNEL=minerva:celery:schedule_sync
CELERY_SCHEDULE_RECONCILE_SECONDS=60
CELERY_BEAT_HOT_RELOAD_VIA_REDIS=true
# Beat 空闲时单次 sleep 上限（秒），便于 UI 改调度后尽快生效
CELERY_BEAT_MAX_LOOP_SECONDS=8
# 定时任务单例锁 TTL（秒）；Worker 异常退出后自动释放
CELERY_SCHEDULED_TASK_LOCK_TTL_SECONDS=3600
# 远程 Redis 连接超时与重试（秒）；Worker/Beat 启动时 broker 连接失败会自动重试
CELERY_REDIS_SOCKET_CONNECT_TIMEOUT=30
CELERY_REDIS_SOCKET_TIMEOUT=30
CELERY_REDIS_HEALTH_CHECK_INTERVAL=30
# 0 = 无限重试直至连上 broker
CELERY_BROKER_CONNECTION_MAX_RETRIES=0
# 设为 1 时 run-celery 跳过启动前 broker PING 检查（仍由 Celery 自行重试）
# CELERY_SKIP_BROKER_PREFLIGHT=1

# -----------------------------------------------------------------------------
# Agent（LangGraph / 记忆 / 文件沙箱）
# -----------------------------------------------------------------------------
AGENT_MAX_PLAN_STEPS=8
AGENT_SUBAGENT_RECURSION_LIMIT=16
AGENT_MEMORY_RETRIEVE_LIMIT=20
AGENT_MESSAGE_FALLBACK_LIMIT=50
# 长期记忆后端：sql（默认）| mem0（pgvector + Neo4j）
# 使用 mem0 前须安装依赖：cd backend && pip install -e ".[dev]"
# （含 mem0ai[nlp] / spaCy；依赖请运行 bash scripts/install-backend.sh 安装）
AGENT_MEMORY_BACKEND=sql
# mem0（仅 AGENT_MEMORY_BACKEND=mem0 时需要）
# MEM0_DATABASE_URL=postgresql://minerva:minerva@127.0.0.1:5432/minerva_memory
# MEM0_PG_HOST=127.0.0.1
# MEM0_PG_PORT=5432
# MEM0_PG_USER=minerva
# MEM0_PG_PASSWORD=minerva
# MEM0_PG_DBNAME=minerva_memory
# MEM0_VECTOR_COLLECTION=mem0
# MEM0_EMBEDDING_DIMS=1536
# MEM0_GRAPH_ENABLED=true
# MEM0_NEO4J_URL=neo4j://127.0.0.1:7687
# MEM0_NEO4J_USERNAME=neo4j
# MEM0_NEO4J_PASSWORD=
# MEM0_LLM_PROVIDER=openai
# MEM0_LLM_MODEL=gpt-4o-mini
# MEM0_LLM_API_KEY=
# MEM0_LLM_BASE_URL=
# MEM0_EMBEDDER_PROVIDER=openai
# Embedding：勿与 LiteLLM chat 代理混用；Qwen/vLLM 请直连 /v1/embeddings 服务。
# 若直连不可达，运行时会自动回退到 MEM0_LLM_BASE_URL（LiteLLM 支持 /v1/embeddings 时可用）。
# MEM0_EMBEDDER_DIRECT_BASE_URL=http://127.0.0.1:8001/v1
# MEM0_EMBEDDER_BASE_URL=http://127.0.0.1:8001/v1
# MEM0_EMBEDDER_MODEL=Qwen3-Embedding-8B
# MEM0_EMBEDDING_DIMS=4096
# MEM0_EMBEDDER_API_KEY=sk-local
# AGENT_MEMORY_MEM0_RERANK_ENABLED=false
# AGENT_MEMORY_LLM_COMPRESS_ENABLED=false
# AGENT_MEMORY_PROFILE_LLM_ENABLED=false
# AGENT_MEMORY_COMPRESS_CELERY_ENABLED=false
AGENT_CHAT_HISTORY_MESSAGE_LIMIT=40
AGENT_ENABLE_THINKING=false
# MCP 客户端/服务端（默认关闭；开启后启动时预热 Registry）
MCP_CLIENT_ENABLED=false
MCP_SERVER_ENABLED=false
MCP_CONNECT_TIMEOUT=30
# LangGraph PostgresSaver checkpoint
AGENT_LANGGRAPH_CHECKPOINT_ENABLED=true
AGENT_LANGGRAPH_CHECKPOINT_POOL_MIN_SIZE=1
AGENT_LANGGRAPH_CHECKPOINT_POOL_MAX_SIZE=8
AGENT_LANGGRAPH_CHECKPOINT_POOL_TIMEOUT=60
AGENT_LANGGRAPH_CHECKPOINT_RETENTION_DAYS=7
AGENT_LANGGRAPH_CHECKPOINT_CLEANUP_ENABLED=true
AGENT_LANGGRAPH_CHECKPOINT_CLEANUP_BATCH_SIZE=1000
# 工作区文件沙箱根目录；空则使用 backend/data/agent-files
AGENT_FILES_ROOT=
AGENT_FILE_MAX_BYTES=524288
# 文件存储本地根目录；空则使用 backend/data/file-storage
FILE_STORAGE_LOCAL_ROOT=./data/file-storage

# 文档翻译
DOC_TRANSLATE_MAX_FILE_BYTES=20971520
DOC_TRANSLATE_SEGMENT_CONCURRENCY=5
DOC_TRANSLATE_OCR_POLL_INTERVAL_SECONDS=2
DOC_TRANSLATE_OCR_TIMEOUT_SECONDS=1800
DOC_TRANSLATE_DEFAULT_OCR_TYPE=PADDLE_OCR
DOC_TRANSLATE_SOFFICE_EXECUTABLE=
DOC_TRANSLATE_SOFFICE_TIMEOUT_SECONDS=120
LAYOUT_PAGE_RASTER_PREFIX=ocr/page-raster
LAYOUT_SCHEMA_VERSION=1

# 知识库（Dataset）
DATASET_VECTOR_STORE=pgvector
DATASET_VECTOR_INDEX_NAME_PREFIX=Vector_index
DATASET_KEYWORD_STORE=jieba
DATASET_BATCH_UPLOAD_LIMIT=10
DATASET_MAX_FILES_PER_DATASET=5
DATASET_SINGLE_FILE_SIZE_LIMIT_MB=100
DATASET_PGVECTOR_URL=
DATASET_QDRANT_URL=
DATASET_QDRANT_API_KEY=
DATASET_WEAVIATE_ENDPOINT=
DATASET_WEAVIATE_API_KEY=

# =============================================================================
# 以下变量不由 app/config.py 读取，供脚本、测试或操作系统使用
# =============================================================================

# scripts/run-backend.*：Uvicorn 监听端口（默认 8000）
# MINERVA_BACKEND_PORT=8000
# scripts/_backend-common.*：默认使用 backend/.venv 中的 Python（无 venv 则报错退出）
# MINERVA_ALLOW_SYSTEM_PYTHON=1
# MINERVA_PYTHON=C:\path\to\python.exe
# scripts/run-celery.*：Celery Worker / Beat（须显式 profile 与子命令，见 README）

# scripts/run-celery.*：Worker 池（Windows 默认 threads；Linux 默认 prefork）
# MINERVA_CELERY_POOL=threads
# MINERVA_CELERY_CONCURRENCY=4
# Worker 默认监听 default 与知识库 dataset 队列（run-celery 脚本已内置）
# MINERVA_CELERY_QUEUES=default,dataset
# 兼容旧开关：MINERVA_CELERY_USE_PREFORK=1 等价于 prefork

# app/file_ocr/service/overview_log_daily_stats.py：日统计时区（未设置则用系统默认）
# TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# 高德 Web 服务（Agent skills: ip_location / district / weather）
# -----------------------------------------------------------------------------
# IP 定位、行政区域查询、天气查询；见 docs/superpowers/specs/2026-06-15-amap-location-weather-skills-design.md
AMAP_WEB_SERVICE_KEY=
