MEM0_LLM_MODEL=deepseek-v4-flash
MEM0_LLM_API_KEY=sk-ByoZO1uiQf6QbSfyzPUyAA
MEM0_LLM_BASE_URL=http://10.150.179.15:4000/v1
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_BASE_URL=http://10.150.179.15:4000/v1
MEM0_EMBEDDER_MODEL=bge-m3
MEM0_EMBEDDING_DIMS=1024
MEM0_EMBEDDER_API_KEY=sk-ByoZO1uiQf6QbSfyzPUyAA
