# 长期记忆后端End
AGENT_ENABLE_THINKING=true
# MCP 客户端/服务端（默认关闭；开启后启动时预热 Registry）
MCP_CLIENT_ENABLED=true
MCP_SERVER_ENABLED=true
MCP_CONNECT_TIMEOUT=30
AGENT_LANGGRAPH_CHECKPOINT_ENABLED=true
AGENT_LANGGRAPH_CHECKPOINT_POOL_MIN_SIZE=1
AGENT_LANGGRAPH_CHECKPOINT_POOL_MAX_SIZE=8
AGENT_LANGGRAPH_CHECKPOINT_POOL_TIMEOUT=60
AGENT_LANGGRAPH_CHECKPOINT_RETENTION_DAYS=7
AGENT_LANGGRAPH_CHECKPOINT_CLEANUP_ENABLED=true
AGENT_LANGGRAPH_CHECKPOINT_CLEANUP_BATCH_SIZE=1000
AGENT_FILES_ROOT=
AGENT_FILE_MAX_BYTES=524288
# --- Agent 优化路线图 (2026-06-22) ---
AGENT_ROUTER_ENABLED=true
AGENT_ROUTER_SIMPLE_MAX_CHARS=120
AGENT_ROUTER_LLM_FALLBACK=false
AGENT_MEMORY_RETRIEVE_SKIP_WHEN_EMPTY=true
AGENT_MEMORY_RECALL_KEYWORDS=
AGENT_SUBAGENT_AINVOKE_FALLBACK=false
AGENT_STEP_FAILURE_POLICY=continue
AGENT_MAX_REPLAN_ATTEMPTS=2
AGENT_PARALLEL_STEPS_ENABLED=false
AGENT_GRAPH_ASTREAM_ENABLED=true

